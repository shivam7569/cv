+import os
+import torch
+import numpy as np
+from tqdm import tqdm
+from torch.utils.data import DataLoader, DistributedSampler
+from torch.nn.parallel import DistributedDataParallel as DDP
+
+from cv import generative
+from cv.utils import Global
+from cv.utils import MetaWrapper
+from cv.utils.os_utils import check_dir
+from cv.utils.code_utils import Container
+import cv.src.losses as custom_loss_fns
+from cv.src import custom_lrs, optimizers
+from cv.src.checkpoints import Checkpoint
+from cv.phases.generation import Eval
+from cv.datasets import GenerationDataset
+from cv.src.gpu_devices import GPU_Support
+from cv.configs.config import setup_config
+from cv.utils.logging_utils import start_logger
+from cv.src.tensorboard import TensorboardWriter
+from cv.utils.training import EMA, RepeatAugSampler
+from cv.utils.pytorch_utils import async_parallel_setup
+
+
+class Train(metaclass=MetaWrapper):
+
+    @classmethod
+    def __class_repr__(cls):
+        return "Training Class for all the backbones"
+
+    _ACTIVITY_MAP = {
+        "CPU": torch.profiler.ProfilerActivity.CPU,
+        "CUDA": torch.profiler.ProfilerActivity.CUDA
+    }
+
+    def __init__(
+            self,
+            generator,
+            discriminator,
+            data_loaders,
+            epochs=100,
+            profiling=None,
+            resume_epoch=0,
+            async_parallel=False,
+            async_parallel_rank=0,
+            lr_tb_write_per_epoch=True
+    ):
+        
+        self.generator = generator
+        self.discriminator = discriminator
+        self.epochs = epochs
+        self.lr_tb_write_per_epoch = lr_tb_write_per_epoch
+        self.resume_epoch = resume_epoch
+
+        self.train_loader = data_loaders["train"]
+        self.val_loader = data_loaders["val"]
+
+        self.profiling = profiling
+        if profiling:
+            if profiling: self._setup_profiler()
+
+        self.async_parallel = async_parallel
+        self.async_parallel_rank = async_parallel_rank
+
+        self._setup_gradient_accumulation("generator")
+        self._setup_gradient_accumulation("discriminator")
+
+        self._setup_ema("generator")
+        self._setup_ema("discriminator")
+
+        if async_parallel:
+            Global.LOGGER.info(f"Training asynchronously with parallel model distribution")
+
+        if not async_parallel_rank:
+            pass
+            # self.evaluation = Eval(
+            #     model=model if exponential_moving_average is None else self.ema_model,
+            #     data_loader=data_loaders["val"],
+            #     loss_function=loss_function,
+            #     tb_writer=tb_writer,
+            #     async_parallel=async_parallel,
+            #     async_parallel_rank=async_parallel_rank
+            # )
+            # self.checkpointer = Checkpoint(
+            #     model if not async_parallel else model.module, optimizer, lr_scheduler
+            # ) # TODO: TBI
+        
+        self.graph_written = False
+        self.sample_batch_log = False
+
+        self.log_train_setting()
+
+    def start(self):
+        if not self.async_parallel_rank: f1_score = np.NINF
+        for epoch in range(self.resume_epoch, self.epochs):
+
+            if self.async_parallel:
+                self.train_loader.sampler.set_epoch(epoch)
+
+            self.generator.tb_writer.setWriter("train")
+            self.discriminator.tb_writer.setWriter("train")
+
+            if self.profiling:
+                epoch_loss = self._run_profiling(epoch=epoch) # TODO: Adapt it for GANs
+            else:
+                epoch_loss = self.train_for_one_epoch(epoch=epoch)
+
+            if self.tb_writer is not None: self.tb_writer.write("scaler")(scalar_name="Loss", scalar_value=epoch_loss, step=epoch)
+
+            if not self.async_parallel_rank:
+                Global.METRICS["epoch"] = epoch
+                Global.METRICS["train_loss"] = epoch_loss
+                
+                if Global.CFG.SCHEDULE_FREE_TRAINING: self.optimizer.eval()
+                self.evaluation.start(epoch=epoch)
+
+                if self.evaluation.epoch_metrics["f1_score"] > f1_score:
+                    f1_score = self.evaluation.epoch_metrics["f1_score"]
+                    self._mark_checkpoint(epoch=epoch, f1_score=f1_score, epoch_chkpt=False)
+                if Global.CFG.CHECKPOINT.SAVE_EPOCH_CHECKPOINTS:
+                    self._mark_checkpoint(epoch=epoch, f1_score=None, epoch_chkpt=True)
+
+                Global.resetEpochMetrics()
+
+            if self.lr_scheduler is not None:
+                self._lr_scheduling(epoch_based=True, epoch=epoch)
+
+            if self.lr_tb_write_per_epoch:
+                if self.tb_writer is not None:
+                    current_lr = self.optimizer.param_groups[0]['lr']
+                    self.tb_writer.write("scaler")(scalar_name="Learning Rate", scalar_value=current_lr, step=epoch)
+
+            if self.updateStochasticDepthRate is not None:
+                if epoch % self.updateStochasticDepthRate[0]["step_epochs"] == 0 and epoch > 0:
+                    self.model.module.updateStochasticDepthRate(self.updateStochasticDepthRate[0]["k"])
+
+    def train_for_one_epoch(self, epoch):
+
+        self.generator.model.train()
+        self.discriminator.model.train()
+
+        if Global.CFG.SCHEDULE_FREE_TRAINING: self.optimizer.train()
+
+        num_iterations = len(self.train_loader)
+        data_iterator = tqdm(self.train_loader, desc=f"Training: Epoch {epoch+1}", unit="batch") if not self.async_parallel_rank else self.train_loader
+        
+        if not self.async_parallel_rank:
+            generator_epoch_loss = 0
+            discriminator_epoch_loss = 0
+
+        for idx, batch in enumerate(data_iterator):
+            img_batch, lbl_batch = batch
+
+            img_batch, lbl_batch = self.discriminator.model.prepare_input(img_batch, lbl_batch) if not self.async_parallel else self.discriminator.model.module.prepare_input(img_batch, lbl_batch)
+
+            noise = self.generator.model.prepare_noise() if not self.async_parallel else self.generator.model.module.prepare_noise()
+            noise = noise.expand(img_batch.shape[0], -1)
+
+            if Global.CFG.SAVE_FIRST_SAMPLE:
+                if (self.discriminator.tb_writer is not None) and (not self.sample_batch_log) and (epoch == 0):
+                    self.discriminator.tb_writer.write("image")(image=GenerationDataset._vizualizeBatch(batch=batch), epoch=epoch+1, tag="Training Sample")
+                    self.sample_batch_log = True
+
+            if not self.async_parallel:
+                if GPU_Support.support_gpu:
+                    last_gpu_id = f"cuda:{GPU_Support.support_gpu - 1}"
+            
+                    img_batch = img_batch.to(last_gpu_id)
+                    if isinstance(lbl_batch, list):
+                        lbl_batch = [i.to(last_gpu_id) if isinstance(i, torch.Tensor) else i for i in lbl_batch]
+                    else:
+                        lbl_batch = lbl_batch.to(last_gpu_id)
+            else:
+                img_batch = img_batch.to(self.async_parallel_rank, non_blocking=True)
+                noise = noise.to(self.async_parallel_rank, non_blocking=True)
+                if isinstance(lbl_batch, list):
+                    lbl_batch = [i.to(self.async_parallel_rank, non_blocking=True) if isinstance(i, torch.Tensor) else i for i in lbl_batch]
+                else:
+                    lbl_batch = lbl_batch.to(self.async_parallel_rank, non_blocking=True)
+
+            if Global.CFG.WRITE_TENSORBOARD_GRAPH:
+                if (self.generator.tb_writer is not None) and (not self.graph_written):
+                    tb_model = self.generator.model if not self.async_parallel else self.generator.model.module
+                    self.generator.tb_writer.write("graph")(model=tb_model, input_to_model=noise)
+                if (self.discriminator.tb_writer is not None) and (not self.graph_written):
+                    tb_model = self.discriminator.model if not self.async_parallel else self.discriminator.model.module
+                    self.discriminator.tb_writer.write("graph")(model=tb_model, input_to_model=img_batch)
+            
+                    self.graph_written = True
+
+            try:
+                fake = self.generator.model(noise, phase="training")
+                fake_output = self.discriminator.model(fake, phase="training")
+                real_output = self.discriminator.model(img_batch, phase="training")
+            except TypeError:
+                fake = self.generator.model(noise)
+                fake_output = self.discriminator.model(fake)
+                real_output = self.discriminator.model(img_batch)
+
+            if isinstance(lbl_batch, list):
+                # loss = lbl_batch[2] * self.loss_function(output, lbl_batch[0]) + (1 - lbl_batch[2]) * self.loss_function(output, lbl_batch[1])
+                pass #TODO: TBI
+            else:
+                generator_loss, discriminator_loss = self._aggregate_loss_components(real_output=real_output, fake_output=fake_output)
+
+            if Global.CFG.REGULARIZATION.MODE in ["L1", "L2"]:
+                if Global.CFG.REGULARIZATION.COMPONENTS in ["generator", "both"]:
+                    generator_loss = self._regularize(model_segment="generator", loss=generator_loss)
+                if Global.CFG.REGULARIZATION.COMPONENTS in ["discriminator", "both"]:
+                    discriminator_loss = self._regularize(model_segment="discriminator", loss=discriminator_loss)
+
+            generator_loss.backward(retain_graph=True)
+            discriminator_loss.backward()
+
+            self._optimizer_step(segment="generator", batch_idx=idx, len_loader=num_iterations)
+            self._optimizer_step(segment="discriminator", batch_idx=idx, len_loader=num_iterations)
+
+            if not self.async_parallel_rank:
+                generator_epoch_loss += generator_loss.item()
+                discriminator_epoch_loss += discriminator_loss.item()
+
+            if self.generator.lr_scheduler is not None:
+                batch_iteration = idx/num_iterations if self.generator.lr_scheduler.__class__.__name__ in ["CosineAnnealingWarmRestarts", "WarmUpLinearLRScheduler"] else idx
+                self._lr_scheduling(segment="generator", epoch_based=False, epoch=epoch, batch_iteration=batch_iteration)
+
+            if self.discriminator.lr_scheduler is not None:
+                batch_iteration = idx/num_iterations if self.discriminator.lr_scheduler.__class__.__name__ in ["CosineAnnealingWarmRestarts", "WarmUpLinearLRScheduler"] else idx
+                self._lr_scheduling(segment="discriminator", epoch_based=False, epoch=epoch, batch_iteration=batch_iteration)
+
+            if not self.async_parallel_rank: data_iterator.set_postfix(
+                {
+                    "gen_loss": generator_loss.item(),
+                    "dis_loss": discriminator_loss.item()
+                }, refresh=True
+            )
+            
+            if not self.lr_tb_write_per_epoch:
+                if self.generator.tb_writer is not None:
+                    current_lr = self.generator.optimizer.param_groups[0]['lr']
+                    self.generator.tb_writer.write("scaler")(scalar_name="Learning Rate", scalar_value=current_lr, step=epoch * num_iterations + idx)
+
+                if self.discriminator.tb_writer is not None:
+                    current_lr = self.discriminator.optimizer.param_groups[0]['lr']
+                    self.discriminator.tb_writer.write("scaler")(scalar_name="Learning Rate", scalar_value=current_lr, step=epoch * num_iterations + idx)
+
+        if not self.async_parallel_rank:
+            generator_epoch_loss /= num_iterations
+            discriminator_epoch_loss /= num_iterations
+            Global.LOGGER.info(f"Generator training loss for epoch {epoch+1}: {round(generator_epoch_loss, 3)}")
+            Global.LOGGER.info(f"Discriminator training loss for epoch {epoch+1}: {round(discriminator_epoch_loss, 3)}")
+
+        self._exponential_moving_average(segment="generator")
+        self._exponential_moving_average(segment="discriminator")
+            
+        if not self.async_parallel_rank: return {
+            "generator_loss": generator_epoch_loss,
+            "discriminator_loss": discriminator_epoch_loss
+        }
+
+    def _setup_gradient_accumulation(self, segment):
+        gan_segment = getattr(self, segment)
+        if gan_segment.gradient_accumulation:
+            gradient_accumulation_batch_size = gan_segment.gradient_accumulation_batch_size
+            assert gradient_accumulation_batch_size is not None and isinstance(gradient_accumulation_batch_size, int)
+            accumulation_iter = gradient_accumulation_batch_size // self.train_loader.batch_size
+            gan_segment.setAttribute("accumulation_iter", accumulation_iter)
+
+    def _setup_ema(self, segment):
+        gan_segment = getattr(self, segment)
+        if gan_segment.exponential_moving_average is not None:
+            ema_model = EMA(
+                model=gan_segment.model.module, 
+                **gan_segment.exponential_moving_average) \
+                    if self.async_parallel else EMA(
+                        model=self.model,
+                        **gan_segment.exponential_moving_average)
+            
+            gan_segment.setAttribute("ema_model", ema_model)
+
+    def _optimizer_step(self, segment, batch_idx, len_loader):
+        gan_segment = getattr(self, segment)
+        if gan_segment.gradient_accumulation:
+            if (batch_idx % gan_segment.accumulation_iter == 0) or (batch_idx + 1 == len_loader):
+                self._gradient_clipping(gan_segment)
+                gan_segment.optimizer.step()
+                gan_segment.optimizer.zero_grad()
+        else:
+            self._gradient_clipping(gan_segment)
+            gan_segment.optimizer.step()
+            gan_segment.optimizer.zero_grad()
+
+    def _gradient_clipping(self, segment):
+        if segment.gradient_clipping is not None:
+            clipping_method, clipping_threshold = segment.gradient_clipping
+            if clipping_method == "val":
+                torch.nn.utils.clip_grad.clip_grad_value_(segment.model.parameters(), clip_value=clipping_threshold)
+            if clipping_method == "norm":
+                torch.nn.utils.clip_grad.clip_grad_norm_(segment.model.parameters(), max_norm=clipping_threshold)
+
+    def _mark_checkpoint(self, epoch, f1_score, epoch_chkpt):
+        if not epoch_chkpt:
+            if '/' in Global.CFG.CHECKPOINT.BASENAME:
+                    basename = Global.CFG.CHECKPOINT.BASENAME.split("/")[-1]
+            else:
+                basename = Global.CFG.CHECKPOINT.BASENAME
+            checkpoint_name = basename + f"_epoch_{epoch+1}_f1_{f1_score}.pth"
+            Global.LOGGER.info(f"Saving metric checkpoint for epoch {epoch+1}")
+            self.checkpointer.save(
+                epoch=epoch,
+                chkp_name=checkpoint_name,
+                overwrite=True
+            )
+        else:
+            self.checkpointer.save(epoch=epoch, chkp_name="epoch_checkpoint.pth", overwrite=False)
+
+    def _exponential_moving_average(self, segment):
+        gan_segment = getattr(self, segment)
+        if gan_segment.exponential_moving_average is not None:
+            if self.async_parallel:
+                gan_segment.ema_model.update(gan_segment.model.module)
+            else:
+                gan_segment.ema_model.update(gan_segment.model)
+
+    def _lr_scheduling(self, segment, epoch_based, epoch=None, batch_iteration=None):
+        gan_segment = getattr(self, segment)
+        if epoch_based:
+            assert epoch is not None
+
+            if gan_segment.lr_scheduler.__class__.__name__ == "ReduceLROnPlateau":
+                    gan_segment.lr_scheduler.step(self.evaluation.epoch_metrics["eval_loss"])
+            if gan_segment.lr_scheduler.__class__.__name__ in ["MultiStepLR", "StepLR"]:
+                gan_segment.lr_scheduler.step()
+            if gan_segment.lr_scheduler.__class__.__name__ == "ExponentialLR":
+                if (epoch + 1) % gan_segment.lr_scheduler_step == 0:
+                    gan_segment.lr_scheduler.step()
+            if gan_segment.lr_scheduler.__class__.__name__ == "MultiplicativeLR":
+                gan_segment.lr_scheduler.step()
+            if gan_segment.lr_scheduler.__class__.__name__ == "WarmUpCosineLRScheduler":
+                gan_segment.lr_scheduler.step()                
+        else:
+            if gan_segment.lr_scheduler.__class__.__name__ == "CyclicLR":
+                gan_segment.lr_scheduler.step()
+            if gan_segment.lr_scheduler.__class__.__name__ == "CosineAnnealingWarmRestarts":
+                gan_segment.lr_scheduler.step(epoch + batch_iteration)
+            if gan_segment.lr_scheduler.__class__.__name__ == "WarmUpLinearLRScheduler":
+                gan_segment.lr_scheduler.step(epoch + batch_iteration)
+
+    def _regularize(self, model_segment, loss):
+        if model_segment == "generator":
+            model = self.generator.model if not self.async_parallel else self.generator.model.module
+        elif model_segment == "discriminator":
+            model = self.discriminator.model if not self.async_parallel else self.discriminator.model.module
+        else:
+            Global.LOGGER.error(f"Invalid component for regularization")
+
+        if Global.CFG.REGULARIZATION.MODE == "L1":
+            l1_reg = sum([param.abs().sum() for name, param in model.named_parameters() if "bias" not in name])
+            loss += Global.CFG.REGULARIZATION.STRENGTH * l1_reg
+        elif Global.CFG.REGULARIZATION.MODE == "L2":
+            l2_reg = sum([(param**2).sum() for name, param in model.named_parameters() if "bias" not in name])
+            loss += Global.CFG.REGULARIZATION.STRENGTH * l2_reg
+
+        return loss
+
+    @staticmethod
+    def get_lr_scheduler(scheduler_name, optimizer, scheduler_params=None):
+        if scheduler_name == "LambdaLR":
+            lr_lambda = lambda epoch: 0.96 * epoch
+            lr_scheduler = getattr(
+                torch.optim.lr_scheduler, scheduler_name
+                )(optimizer, lr_lambda=lr_lambda, **scheduler_params)
+        elif scheduler_name == "MultiplicativeLR":
+            Global.addRuntimeParam("factor", scheduler_params["factor"])
+            try:
+                del scheduler_params["factor"]
+            except:
+                pass
+            lr_lambda = lambda epoch: Global.getRuntimeParam("factor")
+            lr_scheduler = getattr(
+                torch.optim.lr_scheduler, scheduler_name
+            )(optimizer, lr_lambda=lr_lambda, **scheduler_params)
+        elif scheduler_name == "SequentialLR":
+            schedulers = scheduler_params["schedulers"]
+            sequential_schedulers = []
+            for schdlr in schedulers:
+                schdlr_params = schdlr["params"]
+                lr_schdlr = Train.get_lr_scheduler(
+                    schdlr["name"],
+                    optimizer=optimizer,
+                    scheduler_params=schdlr_params
+                )
+                sequential_schedulers.append(lr_schdlr)
+            
+            del scheduler_params["schedulers"]
+
+            lr_scheduler = getattr(torch.optim.lr_scheduler, scheduler_name)(
+                optimizer=optimizer, schedulers=sequential_schedulers, **scheduler_params
+            )
+        else: 
+            try:
+                lr_scheduler = getattr(
+                    torch.optim.lr_scheduler, scheduler_name
+                    )(optimizer, **scheduler_params)
+                return lr_scheduler
+            except:
+                if scheduler_name == "WarmUpCosineLRScheduler":
+                    after_scheduler = scheduler_params["after_scheduler"]
+                    after_scheduler_name = after_scheduler.NAME
+                    after_scheduler_params = after_scheduler.PARAMS
+                    after_lr_scheduler = Train.get_lr_scheduler(
+                        scheduler_name=after_scheduler_name,
+                        optimizer=optimizer,
+                        scheduler_params=after_scheduler_params
+                    )
+                    del scheduler_params["after_scheduler"]
+                    lr_scheduler = getattr(custom_lrs, scheduler_name)(
+                        optimizer=optimizer, after_scheduler=after_lr_scheduler, **scheduler_params
+                    )
+                    return lr_scheduler
+
+                if scheduler_name == "WarmUpLinearLRScheduler":
+                    after_scheduler = scheduler_params["after_scheduler"]
+                    after_scheduler_name = after_scheduler.NAME
+                    after_scheduler_params = after_scheduler.PARAMS
+                    after_lr_scheduler = Train.get_lr_scheduler(
+                        scheduler_name=after_scheduler_name,
+                        optimizer=optimizer,
+                        scheduler_params=after_scheduler_params
+                    )
+                    del scheduler_params["after_scheduler"]
+                    lr_scheduler = getattr(custom_lrs, scheduler_name)(
+                        optimizer=optimizer, after_scheduler=after_lr_scheduler, **scheduler_params
+                    )
+                    return lr_scheduler
+
+        return lr_scheduler
+    
+    def _aggregate_loss_components(self, real_output, fake_output):
+        try:
+            generator_loss = self.generator.loss(fake_output, torch.ones_like(fake_output), phase_dependent=self.generator.phase_dependent)
+        except TypeError:
+            generator_loss = self.generator.loss(fake_output, torch.ones_like(fake_output))
+
+        try:
+            discriminator_loss = (self.discriminator.loss(fake_output, torch.zeros_like(fake_output), phase_dependent=self.generator.phase_dependent) + self.discriminator.loss(real_output, torch.ones_like(real_output), phase_dependent=self.generator.phase_dependent)) / 2
+        except TypeError:
+            discriminator_loss = (self.discriminator.loss(fake_output, torch.zeros_like(fake_output)) + self.discriminator.loss(real_output, torch.ones_like(real_output))) / 2
+
+        return generator_loss, discriminator_loss
+
+    def _setup_profiler(self):
+        self.profiling_trace_path = os.path.join(Global.CFG.PROFILER.PATH, Global.CFG.PROFILER.BASENAME)
+        check_dir(
+            path=self.profiling_trace_path,
+            create=True,
+            forcedCreate=True,
+            tree=True
+        )
+        self.profiler = torch.profiler.profile(
+                activities=[Train._ACTIVITY_MAP[i] for i in ["CPU", "CUDA"]],
+                schedule=torch.profiler.schedule(
+                    wait=1, warmup=1, active=3, repeat=2
+                ),
+                record_shapes=True,
+                profile_memory=True,
+                with_stack=False,
+                with_flops=True,
+                with_modules=True,
+                on_trace_ready=torch.profiler.tensorboard_trace_handler(self.profiling_trace_path)
+            )
+
+    def _run_profiling(self, epoch):
+        with self.profiler as prof:
+            epoch_loss = self.train_for_one_epoch(epoch=epoch)
+            prof.step()
+
+        return epoch_loss
+
