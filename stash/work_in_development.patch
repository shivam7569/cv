+import torch
+import torch.nn as nn
+
+from cv.utils import MetaWrapper
+
+class VanillaGAN_Discriminator(nn.Module, metaclass=MetaWrapper):
+
+    @classmethod
+    def __class_repr__(cls):
+        return "Discriminator class for Vanilla GAN from paper on: Generative Adversarial Nets"
+
+    def __init__(self, img_dim):
+
+        super(VanillaGAN_Discriminator, self).__init__()
+
+        self.discriminator = nn.Sequential(
+            nn.Linear(in_features=img_dim, out_features=128),
+            nn.LeakyReLU(negative_slope=0.1),
+            nn.Linear(in_features=128, out_features=1)
+        )
+
+    def prepare_input(self, img_batch, lbl_batch):
+        img_batch = torch.flatten(img_batch, start_dim=1)
+
+        return img_batch, lbl_batch
+
+    def forward(self, x):
+
+        return self.discriminator(x)
