+import torch
+import torch.nn as nn
+
+from cv.utils import MetaWrapper
+
+class VanillaGAN_Generator(nn.Module, metaclass=MetaWrapper):
+
+    @classmethod
+    def __class_repr__(cls):
+        return "Generator class for Vanilla GAN from paper on: Generative Adversarial Nets"
+
+    def __init__(self, z_dim, img_dim):
+
+        super(VanillaGAN_Generator, self).__init__()
+
+        self.generator = nn.Sequential(
+            nn.Linear(in_features=z_dim, out_features=256),
+            nn.LeakyReLU(negative_slope=0.1),
+            nn.Linear(in_features=256, out_features=img_dim),
+            nn.Tanh()
+        )
+
+        self.z_dim = z_dim
+
+    def prepare_noise(self):
+        noise = torch.randn(1, self.z_dim)
+
+        return noise
+
+    def forward(self, x):
+
+        return self.generator(x)
